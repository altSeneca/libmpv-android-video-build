diff --git a/meson.build b/meson.build
index b15f310..b5f24e3 100644
--- a/meson.build
+++ b/meson.build
@@ -30,7 +30,7 @@ libswscale = dependency('libswscale', version: '>= 7.5.100')
 libplacebo = dependency('libplacebo', version: '>=7.387.0',
                 default_options: ['default_library=static', 'demos=false'])
 
-libass = dependency('libass', version: '>= 0.12.2')
+libass = dependency('libass', version: '>= 0.12.2', required: get_option('libass'))
 
 # the dependency order of libass -> ffmpeg is necessary due to
 # static linking symbol resolution between fontconfig and MinGW
@@ -48,7 +48,7 @@ features = {
     'debug': get_option('debug'),
     'ffmpeg': true,
     'gpl': get_option('gpl'),
-    'libass': true,
+    'libass': libass.found(),
     'libplacebo': true,
 }
 
@@ -207,16 +207,12 @@ sources = files(
     'stream/stream_env.c',
 
     ## Subtitles
-    'sub/ass_mp.c',
     'sub/dec_sub.c',
     'sub/draw_bmp.c',
     'sub/filter_sdh.c',
     'sub/img_convert.c',
     'sub/lavc_conv.c',
     'sub/osd.c',
-    'sub/osd_libass.c',
-    'sub/packer.c',
-    'sub/sd_ass.c',
     'sub/sd_lavc.c',
 
     ## Video
@@ -369,8 +365,17 @@ if features['libdl']
     dependencies += libdl
 endif
 
+if features['libass']
+    sources += files('sub/ass_mp.c', 'sub/osd_libass.c', 'sub/packer.c', 'sub/sd_ass.c')
+else
+    sources += files('sub/osd_dummy.c')
+endif
+
 subrandr = dependency('subrandr', version: '>= 1.1.0', required: get_option('subrandr'))
 features += {'subrandr': subrandr.found()}
+if features['subrandr'] and not features['libass']
+    error('subrandr needs libass (sub/packer.c)')
+endif
 if features['subrandr']
     sources += files('demux/demux_sbr.c', 'sub/sd_sbr.c')
     dependencies += subrandr
